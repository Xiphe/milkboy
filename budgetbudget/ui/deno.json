{
  "name": "@xph/budgetbudget-ui",
  "version": "0.0.1",
  "description": "Preact UI for BudgetBudget",
  "license": "MIT",
  "exports": {
    ".": "./src/main.tsx"
  },
  "lint": {
    "rules": {
      "exclude": ["no-process-global"]
    }
  },
  "imports": {
    "preact": "npm:preact@^10.28.1",
    "preact/hooks": "npm:preact@^10.28.1/hooks",
    "preact/jsx-runtime": "npm:preact@^10.28.1/jsx-runtime"
  },
  "tasks": {
    "build": "deno bundle --minify --sourcemap src/main.tsx -o dist/main.js && cp src/styles.css dist/styles.css"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  }
}
