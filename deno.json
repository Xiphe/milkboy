{
  "workspace": [
    "./moneymoney",
    "./budgetbudget/server",
    "./budgetbudget/ui",
    "./budgetbudget/core"
  ],
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["no-console"]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.16",
    "@std/fs": "jsr:@std/fs@^1.0.21",
    "@std/testing": "jsr:@std/testing@^1.0.16"
  },
  "tasks": {
    "build": {
      "command": "budgetbudget/app/build.sh",
      "dependencies": ["build:app:clean", "build:server:bin", "build:ui"]
    },
    "rebuild": {
      "command": "budgetbudget/app/build.sh --re-bundle-only",
      "dependencies": ["build:server:bin", "build:ui"]
    },

    "build:ui": "deno task --cwd budgetbudget/ui build",
    "build:server:bin": "deno task --cwd budgetbudget/server compile",
    "build:app:clean": "rm -rf budgetbudget/app/build"
  }
}
